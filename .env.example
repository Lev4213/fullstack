# Copy to .env and change values (never commit .env)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=lost_pets

SECRET_KEY=change_me_random_jwt_secret_min_32_chars

DATABASE_URL=postgresql+asyncpg://postgres:change_me_strong_password@db:5432/lost_pets

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

HTTP_PORT=8080

# Local dev (frontend npm run dev) — optional
# VITE_API_URL=http://127.0.0.1:8000
